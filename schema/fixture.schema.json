{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbook-data-standards.github.io/openbook/schema/fixture.schema.json",
  "title": "OpenBook reference_fixture",
  "description": "One match \u2014 the base object. Publisher-own id plus the standard facts (spec \u00a75) that let consumers match it across publishers.",
  "type": "object",
  "required": [
    "openbook_version",
    "id",
    "sequence",
    "updated_at",
    "sport",
    "league",
    "start_time",
    "participants"
  ],
  "properties": {
    "openbook_version": {
      "$ref": "common.schema.json#/$defs/openbook_version"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/own_id"
    },
    "sequence": {
      "$ref": "common.schema.json#/$defs/sequence"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "sport": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/shared_id"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "league": {
      "type": "object",
      "required": [
        "competition_type",
        "id",
        "name",
        "territory"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/own_id"
        },
        "name": {
          "type": "string"
        },
        "territory": {
          "$ref": "common.schema.json#/$defs/territory"
        },
        "wikidata": {
          "$ref": "common.schema.json#/$defs/wikidata"
        },
        "competition_type": {
          "enum": [
            "league",
            "cup",
            "tournament",
            "series",
            "exhibition"
          ]
        }
      }
    },
    "season": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/own_id"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "stage": {
      "type": "object",
      "description": "The leaf stage (shape open, Q20).",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/own_id"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "start_time": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "cutoff_time": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "state": {
      "enum": [
        "scheduled",
        "live",
        "ended",
        "suspended",
        "postponed",
        "cancelled"
      ]
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/own_id",
      "description": "A live event's pregame parent fixture, when applicable."
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "territory",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/own_id"
          },
          "name": {
            "type": "string"
          },
          "territory": {
            "$ref": "common.schema.json#/$defs/territory"
          },
          "role": {
            "$ref": "common.schema.json#/$defs/role",
            "description": "Derived fact, never a source's presentation order."
          },
          "wikidata": {
            "$ref": "common.schema.json#/$defs/wikidata"
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "venue": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "territory": {
          "$ref": "common.schema.json#/$defs/territory"
        },
        "wikidata": {
          "$ref": "common.schema.json#/$defs/wikidata"
        }
      }
    },
    "external_ids": {
      "$ref": "common.schema.json#/$defs/external_ids"
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}