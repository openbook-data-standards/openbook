{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbook-data-standards.github.io/openbook/schema/odds_change.schema.json",
  "title": "OpenBook odds_change",
  "description": "A live price diff with JSON Merge Patch semantics: carries only the markets/outcomes that changed. Every market names its source and provenance. A priced selection is (source, fixture, market_type, segment, line, side).",
  "type": "object",
  "required": ["openbook_version", "sequence", "timestamp", "publisher", "fixture", "markets"],
  "properties": {
    "openbook_version": { "$ref": "common.schema.json#/$defs/openbook_version" },
    "sequence": { "$ref": "common.schema.json#/$defs/sequence" },
    "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" },
    "publisher": { "$ref": "common.schema.json#/$defs/own_id", "description": "The publisher's id (who transmits)." },
    "fixture": { "$ref": "common.schema.json#/$defs/own_id" },
    "markets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["market_type", "source", "provenance", "outcomes"],
        "properties": {
          "market_type": { "$ref": "common.schema.json#/$defs/shared_id" },
          "segment": { "$ref": "common.schema.json#/$defs/shared_id" },
          "line": { "type": "number", "description": "Handicap / total value for the market, when applicable." },
          "status": { "enum": ["open", "suspended", "closed"] },
          "source": { "$ref": "common.schema.json#/$defs/own_id", "description": "Whose odds these are — a source declared in the publisher record." },
          "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
          "outcomes": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["side"],
              "properties": {
                "side": { "$ref": "common.schema.json#/$defs/side" },
                "participant": { "$ref": "common.schema.json#/$defs/own_id", "description": "Required when side = participant." },
                "odds": { "type": ["number", "null"], "exclusiveMinimum": 1.0, "description": "Decimal odds. null = removed (Merge Patch)." },
                "line": { "type": "number" },
                "active": { "type": "boolean" }
              },
              "patternProperties": { "^x_": {} }, "additionalProperties": false
            }
          }
        },
        "patternProperties": { "^x_": {} }, "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^x_": {} },
  "additionalProperties": false
}
