{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbook-data-standards.github.io/openbook/schema/common.schema.json",
  "title": "OpenBook common definitions",
  "description": "Field names are camelCase and follow schema.org where a property exists (startDate, dateModified, alternateName, sameAs, identifier, superEvent). Every document MAY carry JSON-LD @context / @type; the published context is https://openbook-data-standards.github.io/openbook/context.jsonld.",
  "$defs": {
    "openbookVersion": {
      "type": "string",
      "examples": [
        "0.3.0-draft"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per feed, issued by the publisher's server. The `since` cursor."
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with explicit offset."
    },
    "sharedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9-]+)+$",
      "description": "Short form of a shared id (sport:soccer). Formal form: urn:openbook:sport:soccer."
    },
    "ownId": {
      "type": "string",
      "minLength": 1,
      "description": "The publisher's own id, unique within the publisher."
    },
    "territory": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "description": "CLDR territory code: ISO 3166-1 alpha-2 (GB) or ISO 3166-2 subdivision (GB-ENG, US-PR)."
    },
    "sameAs": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://www\\.wikidata\\.org/entity/Q[0-9]+$",
      "description": "schema.org sameAs \u2192 the Wikidata entity URL. The shared entity id: required when one exists, null otherwise."
    },
    "identifier": {
      "type": "array",
      "description": "schema.org identifier as PropertyValue list \u2014 external cross-reference ids.",
      "items": {
        "type": "object",
        "required": [
          "propertyID",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "@type": {
            "type": "string",
            "examples": [
              "PropertyValue"
            ]
          },
          "propertyID": {
            "type": "string",
            "examples": [
              "sportradar",
              "opta"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "alternateName": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "schema.org alternateName \u2014 aliases and other spellings."
    },
    "localizedNames": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Per-language names keyed by ISO 639-1."
    },
    "side": {
      "enum": [
        "home",
        "away",
        "draw",
        "over",
        "under",
        "yes",
        "no",
        "participant"
      ]
    },
    "provenance": {
      "enum": [
        "official",
        "licensed",
        "observed"
      ]
    },
    "role": {
      "enum": [
        "home",
        "away",
        "neutral"
      ],
      "description": "A fact set by the publisher; never inferred from presentation order."
    },
    "jsonld": {
      "properties": {
        "@context": {},
        "@type": {
          "type": "string"
        }
      }
    },
    "enums": {
      "description": "Every closed vocabulary in OpenBook lives here, once. Schemas $ref these; docs/vocabularies are generated from them."
    },
    "objectType": {
      "enum": [
        "fixture",
        "odds",
        "market",
        "score",
        "grade",
        "league",
        "season",
        "stage",
        "participant",
        "player",
        "publisher"
      ]
    },
    "action": {
      "enum": [
        "snapshot",
        "create",
        "update",
        "delete",
        "change"
      ],
      "description": "`change` is used only by `odds`."
    },
    "msgType": {
      "enum": [
        "alert",
        "update",
        "cancel"
      ],
      "description": "CAP 1.2 msgType, on market/update."
    },
    "eventStatus": {
      "enum": [
        "scheduled",
        "delayed",
        "live",
        "paused",
        "suspended",
        "postponed",
        "ended",
        "cancelled"
      ],
      "description": "Fixture lifecycle (Q25). `ended` happens once."
    },
    "marketStatus": {
      "enum": [
        "open",
        "suspended",
        "closed",
        "void"
      ]
    },
    "competitionType": {
      "enum": [
        "league",
        "cup",
        "tournament",
        "series",
        "exhibition"
      ]
    },
    "participantType": {
      "enum": [
        "team",
        "individual"
      ]
    },
    "sourceType": {
      "enum": [
        "sportsbook",
        "exchange",
        "model"
      ]
    },
    "stageType": {
      "enum": [
        "phase",
        "group",
        "round",
        "matchday",
        "leg",
        "seriesGame"
      ]
    },
    "marketShape": {
      "enum": [
        "binary",
        "n-way",
        "over-under",
        "handicap",
        "exact-value",
        "correct-score",
        "yes-no"
      ]
    },
    "marketCategory": {
      "enum": [
        "main-line",
        "score-prop",
        "game-prop",
        "player-prop",
        "outright",
        "parlay-special",
        "same-game-parlay"
      ]
    },
    "segmentStatus": {
      "enum": [
        "pending",
        "live",
        "paused",
        "down"
      ],
      "description": "Per-segment status (Q30). `down` = final, happens once, terminal."
    },
    "statusReason": {
      "enum": [
        "weather",
        "crowd",
        "injury",
        "retirement",
        "walkover",
        "forfeit",
        "technical",
        "scheduling",
        "correction",
        "other"
      ]
    },
    "scoreUnit": {
      "enum": [
        "goals",
        "points",
        "runs",
        "hits",
        "errors",
        "sets",
        "games",
        "frames",
        "strokes",
        "laps",
        "position",
        "time",
        "corners",
        "yellowCards",
        "redCards",
        "wickets",
        "overs",
        "rounds",
        "knockdowns",
        "aces",
        "faults"
      ],
      "description": "What a score line counts (Q26). The sport/league declares its primaryUnit."
    },
    "gradeResult": {
      "enum": [
        "win",
        "lose",
        "void",
        "half-win",
        "half-lose"
      ]
    }
  }
}