{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbook-data-standards.github.io/openbook/schema/common.schema.json",
  "title": "OpenBook common definitions",
  "$defs": {
    "openbook_version": { "type": "string", "examples": ["0.2.0-draft"] },
    "sequence": { "type": "integer", "minimum": 0, "description": "Monotonic per feed, issued by the publisher's server. The `since` cursor." },
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO 8601 with explicit offset." },
    "shared_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9-]+)+$", "description": "Short form of a shared id, e.g. sport:soccer. Formal form: urn:openbook:sport:soccer." },
    "own_id": { "type": "string", "minLength": 1, "description": "The publisher's own id, unique within the publisher." },
    "territory": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$", "description": "CLDR territory code: ISO 3166-1 alpha-2 (GB) or ISO 3166-2 subdivision (GB-ENG, US-PR)." },
    "wikidata": { "type": ["string", "null"], "pattern": "^Q[0-9]+$", "description": "Wikidata QID — the shared entity id. Required when one exists, null otherwise." },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "required": ["system", "id"], "additionalProperties": false,
        "properties": { "system": { "type": "string", "examples": ["sportradar", "opta", "kibl"] }, "id": { "type": "string" } } }
    },
    "localized_names": { "type": "object", "propertyNames": { "pattern": "^[a-z]{2}$" }, "additionalProperties": { "type": "string" }, "description": "Per-language names keyed by ISO 639-1." },
    "side": { "enum": ["home", "away", "draw", "over", "under", "yes", "no", "participant"] },
    "provenance": { "enum": ["official", "licensed", "observed"], "description": "How the publisher obtained the price." },
    "role": { "oneOf": [ { "enum": ["home", "away"] }, { "type": "integer", "minimum": 1, "description": "Ordinal for n-participant events." } ] },
    "extensions": { "patternProperties": { "^x_": {} } }
  }
}
