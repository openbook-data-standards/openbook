{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbook-data-standards.github.io/openbook/schema/settlement.schema.json",
  "title": "OpenBook settlement (proposed, Q24)",
  "description": "The grade of one market for one source. Immutable: a re-settle is a NEW settlementId that names the one it supersedes; a void is a settlement with result void. Delivered as settlement/create; reversed with settlement/delete.",
  "type": "object",
  "required": [
    "openbookVersion",
    "sequence",
    "dateModified",
    "settlementId",
    "fixture",
    "source",
    "marketType",
    "dateSettled",
    "outcomes"
  ],
  "properties": {
    "@context": {},
    "@type": {
      "type": "string"
    },
    "openbookVersion": {
      "$ref": "common.schema.json#/$defs/openbookVersion"
    },
    "sequence": {
      "$ref": "common.schema.json#/$defs/sequence"
    },
    "dateModified": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "settlementId": {
      "$ref": "common.schema.json#/$defs/ownId"
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/ownId",
      "description": "The settlementId this re-settle replaces."
    },
    "fixture": {
      "$ref": "common.schema.json#/$defs/ownId"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/ownId"
    },
    "marketType": {
      "$ref": "common.schema.json#/$defs/sharedId"
    },
    "segment": {
      "$ref": "common.schema.json#/$defs/sharedId"
    },
    "line": {
      "type": "number"
    },
    "dateSettled": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "basis": {
      "type": "string",
      "description": "What it graded on: final score, corners, bookings, a stat."
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "side",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "side": {
            "$ref": "common.schema.json#/$defs/side"
          },
          "participant": {
            "$ref": "common.schema.json#/$defs/ownId"
          },
          "line": {
            "type": "number"
          },
          "result": {
            "$ref": "common.schema.json#/$defs/settlementResult"
          }
        }
      }
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}